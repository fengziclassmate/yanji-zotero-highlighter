{
  "manifest_version": 3,
  "name": "研迹 · Zotero 网页标注",
  "version": "0.5.3",
  "description": "中文网页标注、原文段落定位，将九类摘录整理到 Zotero 10 的一份文献笔记。",
  "permissions": ["storage", "tabs", "sidePanel", "clipboardWrite", "unlimitedStorage"],
  "host_permissions": ["http://127.0.0.1:23119/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "研迹：查看本文标注", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "panel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["shared.js", "anchor.js", "content.js"],
    "run_at": "document_idle"
  }]
}
